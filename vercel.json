{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!api/embed).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/p/:pledge(\\d+)",
      "destination": "/api/share?pledge=:pledge"
    },
    {
      "source": "/p/:pledge(\\d+)/:m(\\d+)",
      "destination": "/api/share?pledge=:pledge&m=:m"
    },
    {
      "source": "/teams",
      "destination": "/api/share?page=teams"
    }
  ],
  "functions": {
    "api/og.mjs": {
      "includeFiles": "api/_lib/fonts/**"
    }
  }
}
